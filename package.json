{
  "name": "utsav-ai-event-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "npm run typecheck:server && esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.js",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "start": "node dist-server/index.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check:docs": "node scripts/check-docs.mjs",
    "check:trace": "node scripts/check-trace.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:gemini": "node scripts/check-gemini.mjs",
    "verify": "npm run lint && npm run coverage && npm run build && npm run check:docs && npm run check:trace && npm run check:size && npm run check:pwa && npm run check:repo && npm run check:contrast && npm run check:security && npm run check:gemini",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:security": "node scripts/check-security.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "eslint-plugin-jsx-a11y": "^6.1.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.15.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
